import {
  "moonbitlang/core/json",
  "moonbitlang/core/debug",
  "justjavac/ffi",
  "justjavac/webview",
}

supported_targets = "+native"

options(
  link: {
    "native": {
      "cc-flags": "-fwrapv -fsanitize=address -fsanitize=undefined",
      "cc-link-flags": "-L../lib -lwebview",
    },
  },
  targets: { "webview_test": [ "native" ] },
)
